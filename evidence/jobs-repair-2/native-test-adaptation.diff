+test('native unavailable source uses one bounded web candidate search and suppresses repeated jobs call',async()=>{const db=await database();await migrate(db.pool);const user=await bootstrap(db.pool);let jobs=0,web=0,model=0;const app=buildApp(db.pool,{agent:{endpoint:'https://example.org',model:'fixture',jobsSearch:async()=>{jobs++;return {status:'unavailable',occupation:'cameriere',city:'Bologna',code:'jobs_policy_unreviewed',retryable:false,originalSearchUrl:'https://www.subito.it/jobs'}},search:async()=>{web++;return {checkedAt:'2026-09-30T00:00:00Z',sources:[{title:'Candidate',url:'https://example.org/jobs/1'}]}},provider:{complete:async(messages:any[])=>{model++;if(model<3)return {role:'assistant',content:null,tool_calls:[call()]};const r=JSON.parse(messages.at(-1).content);assert.equal(r.code,'jobs_retry_suppressed');return {role:'assistant',content:'Source unavailable; candidate links are unverified.'}}}}} as any);try{const base=await app.listen({port:0,host:'127.0.0.1'});const c=(await request(base,'/conversations',user.token,{title:'Jobs'},'POST',randomUUID())).body;const t=(await request(base,`/conversations/${c.id}/turns`,user.token,{baseSequence:0,text:'cameriere Bologna'},'POST',randomUUID())).body;const run=await settled(db.pool,t.id);assert.equal(run.status,'completed');assert.equal(jobs,1);assert.equal(web,1);const receipts=(await db.pool.query("SELECT result FROM agent_tool_receipts WHERE run_id=$1 ORDER BY created_at",[run.id])).rows;assert.equal(receipts[0].result.status,'search_links_only');assert.equal(receipts[0].result.opportunities,undefined);assert.equal(receipts[0].result.searchLinks.length,1);assert.equal(receipts[0].result.constraintStatus,'not_requested');assert.equal(receipts[0].result.sourceUnavailable.code,'jobs_policy_unreviewed');assert.equal(receipts[1].result.code,'jobs_retry_suppressed');}finally{await app.close();await db.close()}});
