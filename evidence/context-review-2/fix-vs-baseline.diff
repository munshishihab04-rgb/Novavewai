+  const pending = (await c.query('SELECT fingerprint FROM files WHERE owner_id=$1 AND request_key=$2', [owner, key])).rows[0];
+  if (pending) fail(409, pending.fingerprint === fingerprint ? 'upload_pending' : 'idempotency_conflict');
