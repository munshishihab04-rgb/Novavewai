# NOVA Community Agent — runtime environment (copy to the data dir as trial.env, mode 600)
# Production path: ~/.local/share/nova-community-trial/trial.env  (loaded by systemd EnvironmentFile)
# NEVER commit the real file. Values below are examples/placeholders.

# ── Access & abuse guards ──────────────────────────────────────────────────────
NOVA_PUBLIC_REGISTRATION=on            # on|off  — kill switch for self-service registration
NOVA_DAILY_RUNS_PER_ACCOUNT=40         # per-account daily agent-run cap (owner/testers exempt below)
NOVA_UNLIMITED_OWNERS=                 # comma-separated user ids exempt from the daily cap

# ── Job discovery sources ─────────────────────────────────────────────────────
# Subito on-demand reader (owner accepted robots-comment/ToS risk on 2026-09-30). Absent = search link only.
NOVA_JOBS_SUBITO_AUTOMATED_ACCESS=owner-accepted
# Subito bounded pagination (owner decision B, 2026-10-01, TEMPORARY — see docs/decisions/2026-10-01-subito-pagination.md).
# Absent = page 1 only. Remove to revert.
NOVA_JOBS_SUBITO_PAGINATION=owner-accepted
# Adzuna official API (https://developer.adzuna.com — register an app; free tier). Absent = source disabled.
NOVA_ADZUNA_APP_ID=
NOVA_ADZUNA_APP_KEY=

# ── Model provider ────────────────────────────────────────────────────────────
# Production (scripts/trial.ts) uses Azure Managed Identity against the Foundry endpoint — no key needed on the VM.
# Alternative generic OpenAI-compatible provider for scripts/server.ts (all three required together):
# NOVA_AGENT_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# NOVA_AGENT_MODEL=gpt-5.4-mini
# NOVA_AGENT_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# NOVA_VOICE_MANAGED=on                # realtime voice via managed provider
# NOVA_REVIEW_FOUNDRY_KEY=             # Foundry Document Intelligence (OCR) — only if that service is enabled
# NOVA_FILE_ROOT=                      # override encrypted file storage root
# NOVA_JOBS_CACHE_DIR=                 # override jobs cache dir
